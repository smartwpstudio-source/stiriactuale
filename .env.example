# Copiază în .env.local (gitignored) și completează cu valori reale.
# Aceleași chei, ca Secrets în GitHub (Settings -> Secrets and variables -> Actions),
# pentru rularea programată din .github/workflows/pipeline.yml.
# Niciodată nu se comit valori reale în acest fișier.

# Postgres (Neon) — site-ul (Vercel) și pipeline-ul (GitHub Actions)
DATABASE_URL=

# Token de abonament Claude Max: generat cu
#   node_modules\@anthropic-ai\claude-agent-sdk-win32-x64\claude.exe setup-token
# Consumă creditul lunar Agent SDK al abonamentului, NU facturare API.
# NU seta ANTHROPIC_API_KEY — ar avea prioritate și s-ar factura API-ul.
CLAUDE_CODE_OAUTH_TOKEN=

# Magnific API: stock foto gratuit pe Premium+ (max 100/zi); generarea de rezervă
# (Flux 2 Turbo) consumă credite din abonament
MAGNIFIC_API_KEY=

# Vercel Blob (Storage -> Blob) — stocare permanentă pentru foto
BLOB_READ_WRITE_TOKEN=

# Doar în Vercel (nu în GitHub): protejează /api/cron/collect. Șir aleator lung,
# ex. generat cu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Parola panoului /admin (Vercel + .env.local). Lungă, unică — nu refolosi alta.
ADMIN_PASSWORD=

# Telegram: bot creat cu @BotFather (token), chat-ul tău privat pentru
# notificări (id numeric — scrie-i botului, apoi vezi getUpdates) și canalul
# public unde se postează știrile (@nume, botul trebuie să fie admin acolo).
# Aceleași trei și în GitHub Secrets (notificarea de draft vine din pipeline).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=
