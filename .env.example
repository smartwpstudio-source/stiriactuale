# Copiază în .env.local (gitignored) și completează cu valori reale.
# Niciodată nu se comit valori reale în acest fișier.

# Claude API — clasificare (Haiku) + generare articol (Sonnet)
ANTHROPIC_API_KEY=

# fal.ai — generare imagine simbol. Opțional: fără el, pipeline-ul publică
# articole fără imagine (vezi src/lib/pipeline/image.ts) în loc să eșueze.
FAL_KEY=

# Postgres (Vercel Postgres / Neon) — necesar pentru publicare
DATABASE_URL=

# Secret verificat de /api/pipeline/run — respinge orice cerere fără el
# (vezi plan-implementare-agregator-stiri-ai.md secțiunea 3.8)
CRON_SECRET=
